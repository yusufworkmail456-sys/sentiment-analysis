# === LLM API (OpenAI-compatible) ===
# Any OpenAI-compatible endpoint: OpenAI, Ollama, vLLM, LiteLLM, 9router, etc.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gpt-3.5-turbo
LLM_API_KEY=your-api-key-here

# === Sentiment Model (HuggingFace) ===
# Default: Indonesian Roberta. Change to any HuggingFace sentiment model.
SENTIMENT_MODEL=w11wo/indonesian-roberta-base-sentiment-classifier

# === App Branding ===
APP_TITLE=Sentiment Analysis
APP_SUBTITLE=Multi-platform · IndoBERT · AI insight

# === Instagram Proxy (optional) ===
# Format: socks5://127.0.0.1:40000
# IG_PROXY=

# === Play Store App IDs (optional) ===
# Add your target app package IDs here
# PLAYSTORE_APP_1=com.example.app
